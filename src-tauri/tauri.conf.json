{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZEX",
  "version": "0.1.0",
  "identifier": "com.zex.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ZEX - 游戏与影视库",
        "label": "main",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#080810"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://covers.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.steamgriddb.com https://api.steampowered.com https://store.steampowered.com https://*.tmdb.org https://*.themoviedb.org ipc: tauri: http://tauri.localhost https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "resources": [
      "resources/mpv/*",
      "resources/skin/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}