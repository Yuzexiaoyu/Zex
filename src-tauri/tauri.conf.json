{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZEX",
  "version": "0.1.0",
  "identifier": "com.zex.app",
  "build": {
    "devtools": true,
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZEX - 游戏与影视库",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.steamgriddb.com https://api.steampowered.com https://store.steampowered.com https://*.tmdb.org https://*.themoviedb.org ipc: tauri: http://tauri.localhost https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:data/zex.db"]
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
